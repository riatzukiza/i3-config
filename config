set $mod Mod4

font pango:monospace 8
include "./conf.d/**/*.conf"
include "./conf.d/*.conf"

exec --no-startup-id bash -c "source ~/.bash_profile"


# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status

floating_modifier $mod

tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec alacritty

bindsym $mod+Shift+s exec flameshot gui

# Toggle picom compositor (managed by systemd --user)
bindsym $mod+Ctrl+Shift+p exec --no-startup-id bash -lc 'systemctl --user is-active --quiet picom.service && systemctl --user stop picom.service || systemctl --user start picom.service'

# Toggle barrier (managed by systemd --user)
bindsym $mod+Ctrl+Shift+b exec --no-startup-id bash -lc 'systemctl --user is-active --quiet barrier.service && systemctl --user stop barrier.service || systemctl --user start barrier.service'

# kill focused window
bindsym $mod+Shift+q kill

bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop


# reload the configuration file
bindsym Mod1+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Emacs vterm on $mod+Enter
bindsym $mod+Shift+Return exec --no-startup-id ~/bin/emvterm




bar {
    status_command i3blocks
}
# Free up the default
# unbindsym $mod+space
# Keep i3's old layout-toggle on a new combo (optional)
# bindsym $mod+Shift+space focus mode_toggle

# Spotlight-like launcher/switcher (whole command quoted: commas in the
# modi list are i3 command separators unless the quote wraps everything)
bindsym $mod+space exec --no-startup-id "rofi -show combi -modi combi,window,drun,run,web:$HOME/.local/bin/rofi-web-search"
# Web search w/ Firefox history + completions
bindsym $mod+slash exec --no-startup-id "rofi -show web -modi web:$HOME/.local/bin/rofi-web-search"
# Playlist launcher (music)
bindsym $mod+m exec --no-startup-id "rofi -show playlists -modi playlists:$HOME/.local/bin/rofi-playlists"
# Optional dedicated modes:
# bindsym $mod+F exec --no-startup-id rofi -show files
# bindsym $mod+P exec --no-startup-id rofi -show drun
# bindsym $mod+W exec --no-startup-id rofi -show window
gaps inner 5
gaps outer 5

for_window [class="plasmashell"] floating enable
for_window [title="Desktop — Plasma"] kill, floating enable, border none
no_focus [class="plasmashell" window_type="notification"]
# i3 4.23 does not know Plasma's on_screen_display window type here.
